# -----------------------------------------------------------------------------
# Currency Converter Environment Configuration
# Copy this file to .env and adjust variables as needed.
# -----------------------------------------------------------------------------

# Phase 1 & 2: Core & Provider Configuration
APP_NAME="Currency Converter API"
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/v1
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]

# Phase 2: Provider Configuration
PRIMARY_PROVIDER=frankfurter
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
SECONDARY_PROVIDER=exchangerate_api
EXCHANGERATE_API_BASE_URL=https://open.er-api.com/v6
# Optional API key if using paid/authenticated tier:
# EXCHANGERATE_API_KEY=
PROVIDER_TIMEOUT_SECONDS=5.0

# Phase 3: Financial Rounding Engine
ROUNDING_POLICY=ROUND_HALF_UP  # Options: ROUND_HALF_UP, ROUND_HALF_EVEN
PIVOT_CURRENCY=EUR
LARGE_MOVEMENT_THRESHOLD_PCT=15.0

# Phase 6: Resilience & Caching
CACHE_BACKEND=memory           # Options: memory, redis (Phase 6 MVP default: memory)
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30.0
RETRY_MAX_ATTEMPTS=3

# Frontend (Streamlit) Configuration
BACKEND_URL=http://127.0.0.1:8000

# Phase 7: Database & Persistence
DATABASE_URL=sqlite+aiosqlite:///./currency_converter.db
SYNC_DATABASE_URL=sqlite:///./currency_converter.db
DB_ECHO=false
BACKGROUND_REFRESH_ENABLED=true
BACKGROUND_REFRESH_INTERVAL_SECONDS=3600

# -----------------------------------------------------------------------------
# Deferred Configuration (Documented for architectural visibility)
# -----------------------------------------------------------------------------
# Phase 6 Redis backend:
# REDIS_URL=redis://localhost:6379/0
